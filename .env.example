# Copy to .env on the server and adjust.

# Password for the phone app. Use something long; the login lasts 90 days per device.
CLIPPER_APP_PASSWORD=change-me

# Where VODs, transcripts and clips are stored on the server. Plan for 15-25 GB per 8-hour VOD.
CLIPPER_HOST_DATA_DIR=/srv/stream-clipper/data

# Port for the phone app on the server. It listens on 127.0.0.1 only, for `tailscale serve`;
# set CLIPPER_BIND=0.0.0.0 to open it to your whole network instead.
CLIPPER_PORT=8080
CLIPPER_BIND=127.0.0.1

# Spoken language of the streams; "none" to auto-detect.
CLIPPER_LANGUAGE=en

# Claude, through Claude Code on your subscription.
CLIPPER_LLM_MODEL=opus
CLIPPER_LLM_EFFORT=high
CLIPPER_HIGHLIGHTS_PER_HOUR=3

# How often each watched channel is checked for new streams, in seconds.
CLIPPER_MONITOR_INTERVAL_S=600

# The upload browser (YouTube Studio). Password for its noVNC view, and the address you open it at,
# e.g. after `sudo tailscale serve --bg --https=8443 6080` on the server:
CLIPPER_BROWSER_PASSWORD=change-me-too
CLIPPER_BROWSER_VIEW_URL=https://<server-name>.<your-tailnet>.ts.net:8443/vnc.html?autoconnect=1&resize=remote

# Shorts layout: "blur" (whole frame over a blurred copy) or "crop" (centre 9:16 crop).
CLIPPER_SHORT_LAYOUT=blur

# Set to libx264 (and CLIPPER_HWACCEL to none) if NVENC isn't available.
CLIPPER_VIDEO_ENCODER=h264_nvenc
CLIPPER_HWACCEL=cuda
