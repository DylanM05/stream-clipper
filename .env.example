# Copy to .env on the server and adjust.

# Password for the phone app. Use something long; the login lasts 90 days per device.
CLIPPER_APP_PASSWORD=change-me

# Where VODs, transcripts and clips are stored on the server. Use an SSD: every step reads or writes the
# whole stream. Plan for 45-60 GB per 8-hour stream at peak, freed by cleanup once it's all uploaded.
CLIPPER_HOST_DATA_DIR=/srv/stream-clipper/data

# A finished stream's big files are deleted this many days after all its clips are uploaded or rejected
# (0 = right away; also changeable on the Videos screen). Each rendered clip is deleted once it's uploaded.
# New downloads wait while less than CLIPPER_MIN_FREE_GB is free.
CLIPPER_CLEANUP_AFTER_DAYS=0
CLIPPER_MIN_FREE_GB=40

# Port for the phone app on the server. It listens on 127.0.0.1 only, for `tailscale serve`;
# set CLIPPER_BIND=0.0.0.0 to open it to your whole network instead.
CLIPPER_PORT=8080
CLIPPER_BIND=127.0.0.1


# Download speed limit in Mbit/s, so a long VOD doesn't use your whole connection (0 = no limit).
# Also changeable in the app, on the Videos screen.
CLIPPER_DOWNLOAD_LIMIT_MBPS=50

# The {date} in titles is the day a stream started in its creators' time zone (a name like America/New_York
# or America/Chicago). A stream that starts before CLIPPER_DAY_STARTS_AT (an hour, 0-12) counts as the night
# before's show.
CLIPPER_TIMEZONE=America/New_York
CLIPPER_DAY_STARTS_AT=6

# Spoken language of the streams; "none" to auto-detect.
CLIPPER_LANGUAGE=en

# Claude, through Claude Code on your subscription.
CLIPPER_LLM_MODEL=opus
CLIPPER_LLM_EFFORT=high
CLIPPER_HIGHLIGHTS_PER_HOUR=3

# How often each watched channel is checked for new streams, in seconds.
CLIPPER_MONITOR_INTERVAL_S=600

# Uploading through the YouTube API: a Google Cloud OAuth client of type "Web application" (README, step 8).
# Its redirect URI is https://<server-name>.<your-tailnet>.ts.net/api/youtube/callback
CLIPPER_GOOGLE_CLIENT_ID=
CLIPPER_GOOGLE_CLIENT_SECRET=
# The category API uploads get (24 = Entertainment, 20 = Gaming, 22 = People & Blogs, 23 = Comedy).
CLIPPER_YOUTUBE_CATEGORY_ID=24

# The upload browser, which reads watched X accounts and uploads to channels not connected to the API (YouTube Studio).
# Password for its noVNC view, and the address you open it at,
# e.g. after `sudo tailscale serve --bg --https=8443 6080` on the server:
CLIPPER_BROWSER_PASSWORD=change-me-too
CLIPPER_BROWSER_VIEW_URL=https://<server-name>.<your-tailnet>.ts.net:8443/vnc.html?autoconnect=1&resize=remote

# Notifications (README, "Notifications"): a Discord channel's webhook (channel settings → Integrations →
# Webhooks). The app's address (https://<server-name>.<your-tailnet>.ts.net) lets them link to the right page.
CLIPPER_DISCORD_WEBHOOK_URL=
CLIPPER_APP_URL=
# Optional: also, or instead, an ntfy topic for phone push notifications, with an access token if it's protected.
CLIPPER_NTFY_URL=
CLIPPER_NTFY_TOKEN=

# Shorts layout: "blur" (whole frame over a blurred copy) or "crop" (centre 9:16 crop).
CLIPPER_SHORT_LAYOUT=blur

# Most memory the worker may use (it's stopped and restarts beyond this, rather than slowing the whole server).
CLIPPER_WORKER_MEMORY=6g

# The phone preview is made while Claude picks clips. true starts it alongside transcription instead: ready
# sooner, but the GPU and memory carry both at once. false for PREVIEW_ON_GPU shrinks its frames on the CPU.
CLIPPER_PREVIEW_WITH_TRANSCRIPTION=false
CLIPPER_PREVIEW_ON_GPU=true

# Set to libx264 (and CLIPPER_HWACCEL to none) if NVENC isn't available.
CLIPPER_VIDEO_ENCODER=h264_nvenc
CLIPPER_HWACCEL=cuda
